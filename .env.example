# Copier ce fichier en .env pour un développement local (jamais commité).
# Toutes ces variables sont réservées au serveur — aucune n'est exposée au navigateur.

# Port d'écoute du serveur. En hébergement, la plateforme impose généralement sa propre
# valeur (souvent via cette même variable PORT) — ne pas coder de port en dur ailleurs.
PORT=3001

# Liste des origines autorisées à appeler l'API (CORS), séparées par des virgules.
# En local, l'origine du serveur de développement Next.js.
CORS_ORIGIN=http://localhost:3000

# Nom de l'environnement d'exécution, utilisé notamment par GET /api/health.
# Exemples : development (local), test (environnement de test en ligne).
APP_ENVIRONMENT=development

# Identifiant du commit déployé, utilisé notamment par GET /api/health.
# Renseigné automatiquement par le pipeline de déploiement — pas de valeur réelle ici.
APP_VERSION=dev

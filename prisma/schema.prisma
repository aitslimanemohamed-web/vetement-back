// Schéma de la base de données (US-009).
//
// Le modèle vit dans le schéma Postgres "app" (pas "public") : la Data API
// Supabase (PostgREST) n'expose que le schéma "public" par défaut, donc les
// comptes utilisateurs restent invisibles à cette API sans configuration
// supplémentaire. Des permissions explicites (REVOKE/GRANT) viennent
// renforcer ce choix — voir prisma/migrations/ et CONTEXTE_PROJET.md.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Connexion applicative (rôle restreint, droits minimaux), utilisée par le
  // serveur en exécution — via le pooler Supavisor en mode transaction chez
  // Supabase.
  url       = env("DATABASE_URL")
  // Connexion utilisée UNIQUEMENT par `prisma migrate deploy` (rôle
  // privilégié) — mécanisme natif de Prisma pour ce cas précis, via le
  // pooler Supavisor en mode session chez Supabase (recommandation Supabase
  // actuelle : https://supabase.com/docs/guides/database/prisma).
  directUrl = env("DIRECT_URL")
  schemas   = ["app"]
}

/// Compte utilisateur (US-009) : uniquement nom d'utilisateur + mot de passe.
/// Pas d'e-mail, de téléphone, d'annonce ni de profil dans ce périmètre.
model User {
  id           String    @id @default(uuid()) @db.Uuid
  /// Nom d'utilisateur normalisé (espaces de bord retirés, NFC), affiché tel
  /// quel — conserve sa casse d'origine.
  username     String
  /// Clé d'unicité : username normalisé, mis en minuscules de façon
  /// indépendante de la langue, puis renormalisé en NFC. Voir
  /// src/auth/register/username-policy.ts pour la fonction exacte, qui doit
  /// rester le seul endroit où cette règle est implémentée.
  usernameKey  String    @unique @map("username_key")
  /// Empreinte Argon2id (jamais le mot de passe en clair, jamais réversible).
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions     Session[]

  @@map("users")
  @@schema("app")
}

/// Session serveur opaque (US-010) : jeton = "<id>.<secret>", seul un hachage
/// du secret est stocké ici (voir src/auth/session/session.service.ts, seule
/// source de vérité pour la génération/validation). Révocation par date
/// (revokedAt), jamais par suppression de ligne — le rôle applicatif n'a
/// d'ailleurs pas le droit DELETE sur cette table (voir la migration).
model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 du secret aléatoire (jamais le secret lui-même) — un hachage
  /// rapide est volontaire ici : contrairement au mot de passe, ce secret a
  /// une entropie élevée (256 bits générés par crypto.randomBytes), un
  /// ralentissement type Argon2id n'apporterait rien et coûterait de la
  /// latence sur CHAQUE requête authentifiée.
  secretHash   String    @map("secret_hash")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Expiration absolue : 24h après création (valeur appliquée côté
  /// application, voir session.service.ts).
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  /// Glissante : mise à jour à chaque validation réussie ; une session
  /// inactive depuis plus de 2h est refusée même si expiresAt n'est pas
  /// encore atteint (voir session.service.ts).
  lastActiveAt DateTime  @default(now()) @map("last_active_at") @db.Timestamptz(6)
  /// Non nulle dès qu'une déconnexion (ou une future révocation) a eu lieu.
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("sessions")
  @@schema("app")
}
